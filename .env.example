# Variables de entorno de Periodismo Seguro.
# Copia este archivo como .env, completa los valores y NO lo subas al repositorio (.env esta en .gitignore).
# Los secretos reales (clave de la base, API key) van solo en el entorno de ejecucion, por ejemplo como
# secretos del Container App en Azure. Si algo se filtra, hay que invalidarlo y reemplazarlo.

# Puerto HTTP de la aplicacion
PORT=8080

# Base de datos. Si no se definen, se usa H2 en memoria (solo desarrollo).
DB_URL=jdbc:postgresql://localhost:5432/periodismo
DB_USER=periodismo
DB_PASSWORD=cambia-esta-clave

# URL publica con la que se arman los enlaces de recuperacion de clave
APP_URL_PUBLICA=http://localhost:8080

# true en produccion (HTTPS): marca la cookie de sesion como Secure
APP_PRODUCCION=false

# Correo de recuperacion: consola (imprime el enlace) o resend (correo real)
APP_CORREO_PROVEEDOR=consola
APP_CORREO_REMITENTE=Periodismo Seguro <onboarding@resend.dev>
RESEND_API_KEY=

# Carpeta de copia rapida de imagenes (opcional; los bytes se guardan en la base de datos)
APP_IMAGENES_DIR=
